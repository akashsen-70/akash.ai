{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's display name." },
        "photoURL": { "type": "string", "description": "User's profile picture URL." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user account was created." }
      },
      "required": ["uid", "email"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A chat session.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the chat." },
        "userId": { "type": "string", "description": "ID of the user who owns the chat." },
        "title": { "type": "string", "description": "Title of the chat." },
        "mode": { "type": "string", "enum": ["study", "chat"], "description": "Mode of the chat." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the chat was created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the chat was last updated." }
      },
      "required": ["id", "userId", "title", "mode", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A message in a chat.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the message." },
        "chatId": { "type": "string", "description": "ID of the chat this message belongs to." },
        "role": { "type": "string", "enum": ["user", "assistant"], "description": "Role of the message sender." },
        "content": { "type": "string", "description": "Content of the message." },
        "type": { "type": "string", "enum": ["text", "image", "notes"], "description": "Type of content." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the message was sent." }
      },
      "required": ["id", "chatId", "role", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat session metadata."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a chat session."
    }
  }
}
